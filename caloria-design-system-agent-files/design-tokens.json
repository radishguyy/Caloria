  "componentRules": {
    "primaryAction": "Light green background, green-ink text, 0 9px 0 #4F7A2A shadow. Hover uses a white-to-light-green gradient. Active removes the shadow and translates 9px down.",
    "secondaryAction": "Pale yellow background with 0 5px 0 #D9B879 shadow. Hover turns light green with green-ink text.",
    "navigation": "Selected items use orange with ink text. Unselected hover uses light green with green-ink text. Never use orange hover.",
    "cards": "Use surface #FFFCF2 with 1.5px #F0DFB0 borders and 33px outer radius. Nested panels use #FFF1CE with 28px radius.",
    "inputs": "Use surface-raised #FFFDF8, 1.5px warm border, 16px radius, and green focus ring.",
    "shape": "Apply squircle corner-shape only inside @supports (corner-shape: squircle)."
  },
  "colorUsage": {
    "estimatedVisualProportions": [
      {
        "role": "warm cream canvas, near-white surfaces, and whitespace",
        "target": "about 65-75%",
        "colors": [
          "#FFF6DB",
          "#FFFCF2",
          "#FFFDF8"
        ]
      },
      {
        "role": "sunken and highlight surfaces",
        "target": "about 12-20%",
        "colors": [
          "#FFF1CE",
          "#F6E58D"
        ]
      },
      {
        "role": "green family for actions, progress, and accents",
        "target": "about 8-12%",
        "colors": [
          "#6AB04C",
          "#BADC58",
          "#4F7A2A",
          "#3F6420"
        ]
      },
      {
        "role": "orange selection and limited emphasis",
