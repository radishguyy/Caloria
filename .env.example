# ==========================================
# Caloria — Environment Configuration
# ==========================================
# Copy this file to `.env` (local) or `.env.production` (deploy) and fill in real values.
# NEVER commit real credentials. Placeholders below are safe defaults for local dev.

# --- Supabase Project ---
# Public URL of your Supabase project (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable / anonymous key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# --- Database (server-side only) ---
# Connection string for Drizzle ORM / postgres-js.
# Use the direct connection for migrations and the Transaction Pooler (Supavisor) port 6543
# for serverless/edge runtime to avoid connection exhaustion.
DATABASE_URL=postgres://postgres:password@localhost:5432/caloria

# --- Google OAuth (Google Cloud Console) ---
# Required ONLY for Google sign-in / sign-up.
# 1. Go to https://console.cloud.google.com → APIs & Credentials → OAuth 2.0 Client IDs
# 2. Create a "Web application" client.
# 3. Authorized redirect URIs must point at Supabase's callback, e.g.:
#      https://your-project.supabase.co/auth/v1/callback
# 4. Authorized JavaScript origins (optional but recommended):
#      http://localhost:3000
#      https://your-deployed-domain.com
# 5. Copy the generated Client ID and Client Secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Manual Supabase Dashboard steps (required before Google login works) ---
# A. https://app.supabase.com → Authentication → Providers → Google → Enable
# B. Paste the Google Client ID and Client Secret from step 4 above.
# C. Set "Site URL" to your app origin (e.g. http://localhost:3000 or https://your-domain.com).
# D. Under "Allowed Redirect URLs" add:
#      http://localhost:3000/auth/callback
#      https://your-domain.com/auth/callback
# (Supabase appends these automatically to the OAuth provider's redirect chain.)

# --- App runtime ---
NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000